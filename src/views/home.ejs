<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <title>Welcome - Admin Panel</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F9F1E7;">
  
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <div style="max-width: 56rem; width: 100%; text-align: center;">
      <!-- Logo/Title -->
      <div style="margin-bottom: 3rem;">
        <h1 style="font-size: 3.75rem; font-weight: bold; color: #111827; margin-bottom: 1rem;">Admin Panel</h1>
        <p style="font-size: 1.5rem; color: #6B7280;">Manage your furniture store with ease</p>
      </div>

      <!-- Action Cards -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
        <a href="/admin/login" style="text-decoration: none;">
          <div style="background: white; border-radius: 0.75rem; padding: 2.5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: 2px solid transparent; transition: all 0.3s;">
            <div style="width: 4rem; height: 4rem; background: #FEF3C7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
              <i data-lucide="log-in" style="width: 2rem; height: 2rem; color: #D97706;"></i>
            </div>
            <h2 style="font-size: 1.5rem; font-weight: 600; color: #111827; margin-bottom: 0.75rem;">Sign In</h2>
            <p style="color: #6B7280; margin: 0;">Access your admin dashboard</p>
          </div>
        </a>

        <a href="/admin/signup" style="text-decoration: none;">
          <div style="background: white; border-radius: 0.75rem; padding: 2.5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); border: 2px solid transparent; transition: all 0.3s;">
            <div style="width: 4rem; height: 4rem; background: #FEF3C7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
              <i data-lucide="user-plus" style="width: 2rem; height: 2rem; color: #D97706;"></i>
            </div>
            <h2 style="font-size: 1.5rem; font-weight: 600; color: #111827; margin-bottom: 0.75rem;">Sign Up</h2>
            <p style="color: #6B7280; margin: 0;">Create a new admin account</p>
          </div>
        </a>
      </div>

      <!-- Features -->
      <div style="background: white; border-radius: 0.75rem; padding: 2.5rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: left;">
        <h3 style="font-size: 1.25rem; font-weight: 600; color: #111827; margin-bottom: 1.5rem; text-align: center;">What You Can Do</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem;">
          <div style="display: flex; align-items: start; gap: 1rem;">
            <div style="width: 2.5rem; height: 2.5rem; background: #FEF3C7; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="users" style="width: 1.25rem; height: 1.25rem; color: #D97706;"></i>
            </div>
            <div>
              <h4 style="font-weight: 600; color: #111827; margin: 0 0 0.25rem 0;">Manage Users</h4>
              <p style="font-size: 0.875rem; color: #6B7280; margin: 0;">Control user status and permissions</p>
            </div>
          </div>

          <div style="display: flex; align-items: start; gap: 1rem;">
            <div style="width: 2.5rem; height: 2.5rem; background: #FEF3C7; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="building-2" style="width: 1.25rem; height: 1.25rem; color: #D97706;"></i>
            </div>
            <div>
              <h4 style="font-weight: 600; color: #111827; margin: 0 0 0.25rem 0;">Manage Providers</h4>
              <p style="font-size: 0.875rem; color: #6B7280; margin: 0;">Add, edit, and remove providers</p>
            </div>
          </div>

          <div style="display: flex; align-items: start; gap: 1rem;">
            <div style="width: 2.5rem; height: 2.5rem; background: #FEF3C7; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="package" style="width: 1.25rem; height: 1.25rem; color: #D97706;"></i>
            </div>
            <div>
              <h4 style="font-weight: 600; color: #111827; margin: 0 0 0.25rem 0;">Manage Products</h4>
              <p style="font-size: 0.875rem; color: #6B7280; margin: 0;">Full control over product catalog</p>
            </div>
          </div>

          <div style="display: flex; align-items: start; gap: 1rem;">
            <div style="width: 2.5rem; height: 2.5rem; background: #FEF3C7; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <i data-lucide="bar-chart-3" style="width: 1.25rem; height: 1.25rem; color: #D97706;"></i>
            </div>
            <div>
              <h4 style="font-weight: 600; color: #111827; margin: 0 0 0.25rem 0;">View Analytics</h4>
              <p style="font-size: 0.875rem; color: #6B7280; margin: 0;">Track performance and stats</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
